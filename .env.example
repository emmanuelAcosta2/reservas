# Copiar a .env.local y completar con los datos del proyecto de Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (publishable / anon). Nunca poner acá la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para los scripts de base de datos (npm run db:push, db:seed). No la usa la app.
# Usar la cadena "Session pooler" de Connect, con la contraseña codificada como URL.
DATABASE_URL=
